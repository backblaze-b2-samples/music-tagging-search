{
  "name": "music-tagging-search",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @music-tagging-search/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @music-tagging-search/web build",
    "typecheck": "pnpm --filter @music-tagging-search/web typecheck",
    "lint": "pnpm --filter @music-tagging-search/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @music-tagging-search/web exec playwright test",
    "analyze": "cd services/api && .venv/bin/python scripts/analyze.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.15",
      "@isaacs/brace-expansion": "5.0.9",
      "@babel/core": "7.29.6",
      "ajv": "8.20.0",
      "ajv@<7": "6.15.0",
      "body-parser": "2.3.0",
      "brace-expansion": "2.1.4",
      "brace-expansion@<2": "1.1.18",
      "express-rate-limit": "8.6.2",
      "fast-uri": "3.1.5",
      "flatted": "3.4.4",
      "hono": "4.13.2",
      "ip-address": "10.5.0",
      "js-yaml": "4.3.1",
      "lodash": "4.18.1",
      "minimatch": "10.2.6",
      "minimatch@<4": "3.1.5",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.2",
      "picomatch": "4.0.5",
      "picomatch@<3": "2.3.2",
      "postcss": "8.5.26",
      "postcss-selector-parser": "7.1.3",
      "qs": "6.15.3",
      "sharp": "0.35.3",
      "shell-quote": "1.9.0"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
