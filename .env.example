# Backblaze B2 (required) — S3-compatible API, standard B2_* names.
B2_ENDPOINT=your_b2_endpoint
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_region

# Optional: public base URL for the bucket (CDN or friendly domain). Leave
# blank to rely on presigned URLs only.
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (placeholders — not real keys):
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_APPLICATION_KEY_ID=<your-25-char-keyID-from-the-B2-console>
# B2_APPLICATION_KEY=<your-31-char-applicationKey-shown-once>
# B2_BUCKET_NAME=my-music-catalog
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-music-catalog.s3.us-west-004.backblazeb2.com
